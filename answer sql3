UPDATE orders
SET total_price = (
    SELECT SUM(po.amount * p.price)
    FROM products_orders po
    JOIN products p ON po.product_id = p.product_id
    WHERE po.order_id = orders.order_id
);

SELECT max(total_price), min(total_price), avg(total_price) 
FROM orders;

SELECT o.customer_name, sum(po.amount) as total_items
FROM orders o
JOIN products_orders po on o.order_id = po.order_id
GROUP by o.customer_name
ORDER by total_items DESC
LIMIT 1;

SELECT max(po.total_amount), min(po.total_amount), avg(po.total_amount)
FROM(SELECT product_id, SUM(amount) AS total_amount
	FROM products_orders
	GROUP by product_id) po
JOIN products p on po.product_id = p.product_id;
	
SELECT c.category_id, c.name , SUM(po.amount) AS total_sold
FROM category c
JOIN products p ON c.category_id = p.category_id
JOIN products_orders po ON p.product_id = po.product_id
GROUP BY c.category_id, c.name
ORDER BY total_sold DESC
LIMIT 1;

SELECT c.category_id, c.name, SUM(po.amount) AS total_sold
FROM category c
JOIN products p ON c.category_id = p.category_id
JOIN products_orders po ON p.product_id = po.product_id
GROUP BY c.category_id, c.name
ORDER BY total_sold ASC
LIMIT 1;
